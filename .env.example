# Copy to .env (git-ignored) and fill in. Never commit .env; CI fails if one is tracked.
# Read by adapter-verify from the working directory; real environment variables win.

# Gemini API key for golden-task runs (reference agent and judge). Create one in
# Google AI Studio. Free-tier content is used by Google to improve its products, so
# golden inputs must stay synthetic (DESIGN.md session 17).
ADAPTER_GOLDEN_GEMINI_API_KEY=

# Runs may only reach the Gemini API; everything else is blocked.
ADAPTER_GOLDEN_EGRESS_ALLOWED_HOSTS=["generativelanguage.googleapis.com"]
