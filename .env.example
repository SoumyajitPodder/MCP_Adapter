# Copy to .env (git-ignored) and fill in. Never commit .env; CI fails if one is tracked.
# Read by adapter-verify from the working directory; real environment variables win.

# Golden-task runs call a model API for the reference agent (provider in agent.yaml) and the
# judge (ADAPTER_GOLDEN_JUDGE_PROVIDER, default nvidia). Set the key of each provider you use.
# Golden inputs are synthetic only: free tiers may use submitted content.

# NVIDIA API catalog key (build.nvidia.com), D-095.
ADAPTER_GOLDEN_NVIDIA_API_KEY=

# Gemini API key (Google AI Studio), D-083.
ADAPTER_GOLDEN_GEMINI_API_KEY=

# Judge: provider and optional model pin (defaults: moonshotai/kimi-k3, gemini-3.8-flash).
# ADAPTER_GOLDEN_JUDGE_PROVIDER=nvidia
# ADAPTER_GOLDEN_JUDGE_MODEL=

# Runs may reach the API host of each provider with a key; list any other allowed host here.
# ADAPTER_GOLDEN_EGRESS_ALLOWED_HOSTS=[]
