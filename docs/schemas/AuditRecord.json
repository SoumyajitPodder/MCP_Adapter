{
  "$defs": {
    "AuditEvent": {
      "additionalProperties": false,
      "description": "What happened. Details are flat scalars and must already be redacted.",
      "properties": {
        "actor": {
          "description": "Principal that caused the event.",
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "detail": {
          "additionalProperties": {
            "$ref": "#/$defs/DetailValue"
          },
          "title": "Detail",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/AuditKind"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "actor",
        "occurred_at"
      ],
      "title": "AuditEvent",
      "type": "object"
    },
    "AuditKind": {
      "enum": [
        "access_decision",
        "idempotency_transition",
        "manual_reconciliation",
        "baseline_accept",
        "ci_override",
        "anchor"
      ],
      "title": "AuditKind",
      "type": "string"
    },
    "DetailValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "minLength": 1,
      "title": "Chain Id",
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/AuditEvent"
    },
    "prev_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prev Hash"
    },
    "record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Hash",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    }
  },
  "required": [
    "chain_id",
    "seq",
    "prev_hash",
    "record_hash",
    "event"
  ],
  "title": "AuditRecord",
  "type": "object"
}
