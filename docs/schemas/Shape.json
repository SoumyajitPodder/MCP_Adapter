{
  "$defs": {
    "FieldShape": {
      "additionalProperties": false,
      "description": "One field of an operation's input or output.",
      "properties": {
        "enum_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allowed values. Set exactly when type is enum.",
          "title": "Enum Values"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "date-time, a regex, or a fixed-width layout reference.",
          "title": "Format"
        },
        "nullable": {
          "description": "Field may be null when present.",
          "title": "Nullable",
          "type": "boolean"
        },
        "path": {
          "description": "Field path, e.g. \"order.items[].sku\".",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "required": {
          "description": "Field must be present.",
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/FieldType",
          "description": "Normalized field type."
        }
      },
      "required": [
        "path",
        "type",
        "required",
        "nullable"
      ],
      "title": "FieldShape",
      "type": "object"
    },
    "FieldType": {
      "description": "Normalized field type across all source kinds.",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "object",
        "array",
        "datetime",
        "enum",
        "null"
      ],
      "title": "FieldType",
      "type": "string"
    },
    "OperationShape": {
      "additionalProperties": false,
      "description": "One operation of a source, with fields in canonical order.",
      "properties": {
        "errors": {
          "description": "Declared error identifiers.",
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array",
          "uniqueItems": true
        },
        "inputs": {
          "description": "Input fields, sorted by path.",
          "items": {
            "$ref": "#/$defs/FieldShape"
          },
          "title": "Inputs",
          "type": "array"
        },
        "name": {
          "description": "Operation name within the source.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "description": "Output fields, sorted by path.",
          "items": {
            "$ref": "#/$defs/FieldShape"
          },
          "title": "Outputs",
          "type": "array"
        }
      },
      "required": [
        "name",
        "inputs",
        "outputs",
        "errors"
      ],
      "title": "OperationShape",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a shape came from and how much to trust it.",
      "properties": {
        "extracted_at": {
          "description": "Extraction time, timezone-aware.",
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "extractor": {
          "description": "Extractor that produced the shape.",
          "minLength": 1,
          "title": "Extractor",
          "type": "string"
        },
        "extractor_version": {
          "description": "Extractor version.",
          "minLength": 1,
          "title": "Extractor Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind",
          "description": "How strong the evidence behind the shape is."
        },
        "sample_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Samples behind an observed or inferred shape; None when declared.",
          "title": "Sample Count"
        }
      },
      "required": [
        "kind",
        "sample_count",
        "extractor",
        "extractor_version",
        "extracted_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "description": "Strength of the evidence behind a shape (brief 5.3).",
      "enum": [
        "declared",
        "observed",
        "inferred"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "SourceKind": {
      "description": "Kind of upstream artifact a shape was extracted from.",
      "enum": [
        "openapi",
        "wsdl",
        "file",
        "queue",
        "observed",
        "canonical"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Normalized shape of one upstream source. The unit of a baseline.",
  "properties": {
    "operations": {
      "description": "Operations, sorted by name.",
      "items": {
        "$ref": "#/$defs/OperationShape"
      },
      "title": "Operations",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "Evidence behind the shape. Excluded from the hash."
    },
    "source_id": {
      "description": "Stable source identifier, e.g. \"order-management.rest.get-order\".",
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind",
      "description": "Kind of source the shape was extracted from."
    },
    "source_version": {
      "description": "Version of the source artifact.",
      "minLength": 1,
      "title": "Source Version",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "source_kind",
    "source_version",
    "operations",
    "provenance"
  ],
  "title": "Shape",
  "type": "object"
}
