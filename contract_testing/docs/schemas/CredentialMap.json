{
  "$defs": {
    "CredentialBinding": {
      "additionalProperties": false,
      "properties": {
        "secret_name": {
          "description": "Name, never value.",
          "pattern": "^[A-Za-z0-9_./-]{1,128}$",
          "title": "Secret Name",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "versions": {
          "description": "SemVer range this credential serves.",
          "title": "Versions",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "versions",
        "secret_name"
      ],
      "title": "CredentialBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/CredentialBinding"
      },
      "title": "Bindings",
      "type": "array"
    }
  },
  "required": [
    "bindings"
  ],
  "title": "CredentialMap",
  "type": "object"
}
